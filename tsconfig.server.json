{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".server-build",
    "noEmitOnError": true
  },
  "include": ["api/**/*.ts", "server/**/*.ts", "src/quiz.ts"]
}
